import React, { useState } from 'react';
import { QuantumParticleBackground } from './QuantumParticleBackground';
import { Sidebar } from './Sidebar';
import { useAuth } from '@/_core/hooks/useAuth';
import { Loader2 } from 'lucide-react';

interface QuantumDashboardProps {
  children: React.ReactNode;
}

export function QuantumDashboard({ children }: QuantumDashboardProps) {
  const { user, loading } = useAuth();
  const [sidebarOpen, setSidebarOpen] = useState(true);

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-screen bg-background">
        <div className="flex flex-col items-center gap-4">
          <Loader2 className="w-12 h-12 animate-spin text-accent neon-glow" />
          <p className="text-foreground/60 font-mono">Initializing quantum systems...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="relative w-full min-h-screen bg-background overflow-hidden">
      {/* Quantum particle background */}
      <QuantumParticleBackground />

      {/* Cyber grid overlay */}
      <div className="cyber-grid fixed inset-0 pointer-events-none z-0" />

      {/* Main content */}
      <div className="relative z-10 flex h-screen">
        {/* Sidebar */}
        <Sidebar isOpen={sidebarOpen} onToggle={() => setSidebarOpen(!sidebarOpen)} />

        {/* Main content area */}
        <div
          className={`flex-1 overflow-auto transition-all duration-300 ${
            sidebarOpen ? 'ml-0' : 'ml-0'
          }`}
        >
          {/* Header */}
          <header className="sticky top-0 z-40 border-b border-accent/20 bg-background/80 backdrop-blur-sm">
            <div className="flex items-center justify-between px-6 py-4">
              <div className="flex items-center gap-4">
                <button
                  onClick={() => setSidebarOpen(!sidebarOpen)}
                  className="p-2 hover:bg-accent/10 rounded-lg transition-colors"
                >
                  <svg
                    className="w-6 h-6 text-accent"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M4 6h16M4 12h16M4 18h16"
                    />
                  </svg>
                </button>
                <h1 className="text-2xl font-bold gradient-text font-mono">
                  QUANTUM BLOCKCHAIN SIMULATOR
                </h1>
              </div>
              {user && (
                <div className="flex items-center gap-4">
                  <div className="text-right">
                    <p className="text-sm text-foreground/60 font-mono">User</p>
                    <p className="text-sm font-semibold text-accent neon-glow">{user.name}</p>
                  </div>
                </div>
              )}
            </div>
          </header>

          {/* Page content */}
          <main className="p-6">
            {children}
          </main>
        </div>
      </div>
    </div>
  );
}
